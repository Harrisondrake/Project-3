   "source": [
    "3. Create paramaters"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "6e04935f",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Set the IDM parameters\n",
    "v0 = 30    # desired velocity (m/s)\n",
    "s0 = 2     # minimum spacing (m)\n",
    "T = 1.5    # desired time headway (s)\n",
    "a_param = 1.0    # maximum acceleration (m/s^2)  \n",
    "b = 1.5    # comfortable deceleration (m/s^2)\n",
    "delta = 4  # acceleration exponent\n",
    "\n",
    "# Initialize arrays to store simulation results\n",
    "n_steps = len(time_data)       # number of simulation steps we will take, which will be equal to the length of the trajectory data\n",
    "sim_position = np.zeros(n_steps)  # simulated follower position; we will create a vector with all zeroes  as a start\n",
    "sim_speed = np.zeros(n_steps)     # simulated follower speed; we will create a vector with all zeroes  as a start\n",
    "sim_acceleration = np.zeros(n_steps)  # simulated follower acceleration; we will create a vector with all zeroes  as a start\n",
    "\n",
    "# Start at the real follower's initial state\n",
    "sim_position[0] = data_subset['follower_position(m)'].values[0]  #this makes the starting value [0] same as the follower vehicle position\n",
    "sim_speed[0] = data_subset['follower_speed(m/s)'].values[0]  #this makes the starting value [0] same as the follower vehicle speed"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ecb41f28",
   "metadata": {},
   "source": [
    "4. Run Simulation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "e337a6f8",
   "metadata": {},
   "outputs": [
